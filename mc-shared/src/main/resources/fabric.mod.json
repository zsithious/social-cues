{
  "schemaVersion": 1,
  "id": "socialcues",
  "version": "${version}",
  "name": "Social Cues",
  "description": "See when players are typing, browsing a GUI, or idle. Open source, independent alternative implementation.",
  "authors": ["zsithious"],
  "license": "MIT",
  "icon": "assets/socialcues/icon.png",${contact_block}
  "environment": "*",
  "mixins": [
    "socialcues.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "dev.zsithious.socialcues.mcshared.SocialCuesInitializer"
    ],
    "client": [${client_entrypoints}],
    "modmenu": [${modmenu_entrypoints}],
    "voicechat": ["dev.zsithious.socialcues.voicechat.SocialCuesVoicechatPlugin"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${mc_version_range}",
    "java": ">=21",
    "fabric-api": "*"${extra_depends}
  },
  "suggests": {
    "modmenu": "*",
    "voicechat_api": ">=2.6.0"
  }
}
